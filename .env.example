# Copy to .env and set a strong password (never commit .env).
# One password is shared by MySQL root, PostgreSQL postgres and pgAdmin.
ADMIN_PASSWORD=change_me

# Default host ports. start.sh moves a service to the next free port when its
# default is taken or reserved by Windows; the result is written to .ports.env.
MYSQL_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379
TRAEFIK_PORT=80
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PHPMYADMIN_PORT=8080
PGADMIN_PORT=5050

# pgAdmin login email (the password is ADMIN_PASSWORD)
PGADMIN_EMAIL=admin@example.com
